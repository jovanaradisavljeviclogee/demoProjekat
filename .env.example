# ==============================================================================
# .env.example — šablon environment konfiguracije
#
# UC-01:  cp .env.example .env  →  docker compose up -d --build
#
# Ovaj fajl JE u repozitorijumu, pa ne sme sadržati nijedan stvarni kredencijal.
# Sve lozinke ispod su placeholderi koji se menjaju u lokalnom `.env`
# (design.md 10.3). `.env` nije u repozitorijumu i nije u build kontekstu
# (v. .dockerignore, FR-56), pa nijedna tajna ne završava u sloju image-a (AC-13).
# ==============================================================================

# --- Aplikacija ---------------------------------------------------------------
# Laravel runtime konfiguracija.
# APP_KEY se NAMERNO ostavlja prazan: entrypoint ga generiše pri prvom startu
# ako je prazan (ugovor 4.5). Zato posle kopiranja ovog fajla nema nijednog
# ručnog koraka (NFR-02).
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Port mora pratiti WEB_HOST_PORT iz grupe "Host portovi" (AC-01).
APP_URL=http://localhost:8080

# --- Konekcija ka bazi (čita servis `app`) ------------------------------------
# DB_HOST je ime Compose servisa, nikada IP adresa (C-03, FR-05, AC-15).
# DB_PORT je INTERNI port MySQL-a unutar Compose mreže; 3307 je isključivo
# host-side mapiranje i ovde ne sme stajati (FR-33).
# DB_DATABASE / DB_USERNAME / DB_PASSWORD moraju biti identični odgovarajućim
# MYSQL_* vrednostima ispod — `app` se konektuje na bazu koju `db` kreira.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=change_me_app_db_password

# --- Sesija -------------------------------------------------------------------
# `file` driver, ne podrazumevani `database`: administracija payment metoda drži
# radnu kopiju u sesiji, a tiket zabranjuje bazu kao skladište tih podataka
# (ADR-16). `cookie` je bio prvi izbor i izmeren je kao neispravan — kolačić puca
# na ~4 KB, što je već šesta metoda, i to tiho: POST vraća 201, a lista se ne menja.
SESSION_DRIVER=file

# --- Inicijalizacija baze (čita servis `db`) ----------------------------------
# MySQL image koristi ove vrednosti SAMO pri prvoj inicijalizaciji praznog
# volume-a `db-data`. Izmena posle prvog starta nema efekta dok se volume ne
# obriše sa `docker compose down -v` (design.md 8.1).
# MYSQL_USER ne sme biti `root` — MySQL image odbija takvu vrednost.
MYSQL_DATABASE=laravel
MYSQL_USER=laravel
MYSQL_PASSWORD=change_me_app_db_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# --- Host portovi (čita Compose) ----------------------------------------------
# Jedine dve tačke izložene hostu (design.md 10.4). Menjaju se ovde, bez diranja
# compose.yaml. Servis `app` se namerno ne izlaže hostu (FR-03).
WEB_HOST_PORT=8080
DB_HOST_PORT=3307

# --- Xdebug (čita servis `app`) -----------------------------------------------
# Xdebug je uvek instaliran; XDEBUG_MODE je prekidač koji ne traži rebuild
# (FR-61, ADR-08). `debug` = breakpoint radi odmah posle `up` (AC-09);
# `off` = pune performanse kad debugger nije potreban.
XDEBUG_MODE=debug

# Xdebug NE sluša — on iz kontejnera ZOVE IDE na hostu (design.md 9.4).
# Zato kontejner mora znati adresu hosta, i zato se ta vrednost razlikuje po
# okruženju (rizik R-03 — najčešći razlog zašto AC-09 padne):
#   * Docker Desktop (macOS / Windows): `host.docker.internal` se razrešava
#     nativno, bez ikakve dodatne konfiguracije.
#   * Linux / WSL2 sa nativnim Docker Engine-om: isto ime radi zato što
#     compose.yaml mapira `host.docker.internal:host-gateway` za servis `app`.
# Ako breakpoint i dalje ne radi, ovde ide ime ili alias hosta — nikada
# hardkodovana IP adresa (C-03).
XDEBUG_CLIENT_HOST=host.docker.internal

# Port na kome IDE SLUŠA na host mašini.
XDEBUG_CLIENT_PORT=9003
XDEBUG_IDE_KEY=PHPSTORM

# --- Seed (čita servis `app`) -------------------------------------------------
# Lozinka seed korisnika se ne hardkoduje u seeder-u nego se čita odavde
# (FR-36, C-02). Placeholder — zameniti u lokalnom `.env`.
SEED_USER_PASSWORD=change_me_seed_password

# --- Identitet non-root korisnika (build + runtime) ---------------------------
# uid/gid korisnika `appuser` u `app` kontejneru. Bind mount ne prevodi
# vlasništvo: ako se ove vrednosti razlikuju od vlasnika fajlova na hostu
# (`id -u` / `id -g`), pisanje u storage/ puca ili fajlovi na hostu postaju
# root-vlasništvo (design.md 10.2, rizik R-02). Izmena traži rebuild image-a.
# Ovo su identifikatori, ne tajne — smeju u istoriju image-a (AC-13).
APP_UID=1000
APP_GID=1000
